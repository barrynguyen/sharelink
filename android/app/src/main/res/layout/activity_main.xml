<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Terminal header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt;_ SHARELINK"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#00FF41"
            android:fontFamily="monospace"
            android:layout_gravity="start"
            android:paddingTop="12dp"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// stream.video --to=display"
            android:textSize="11sp"
            android:textColor="#1a8c1a"
            android:fontFamily="monospace"
            android:paddingBottom="20dp" />

        <!-- Card: Kết nối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ HOST ]"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="#00B82E"
                android:fontFamily="monospace"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etIp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="192.168.x.x:8765"
                    android:textColorHint="#0d4a0d"
                    android:textColor="#00FF41"
                    android:inputType="text"
                    android:background="@drawable/input_bg"
                    android:paddingHorizontal="10dp"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:importantForAutofill="no"
                    android:autofillHints=""
                    android:privateImeOptions="nm" />

                <Button
                    android:id="@+id/btnScanQr"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="▦"
                    android:backgroundTint="#0a0f0a"
                    android:textColor="#00FF41"
                    android:textSize="22sp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="CONNECT"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#00B82E"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="14dp"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="#FF3030" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="offline"
                    android:textSize="12sp"
                    android:textColor="#1a8c1a"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: Video URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ PAYLOAD ]"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="#00B82E"
                android:fontFamily="monospace"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://..."
                android:textColorHint="#0d4a0d"
                android:textColor="#00FF41"
                android:inputType="textUri"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:minLines="2"
                android:layout_marginBottom="10dp"
                android:importantForAutofill="no"
                android:autofillHints=""
                android:privateImeOptions="nm" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="&gt; EXECUTE"
                android:backgroundTint="#00FF41"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- Card: Điều khiển -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ CONTROL ]"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textColor="#00B82E"
                android:fontFamily="monospace"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="⛶  fullscreen"
                android:backgroundTint="#0a0f0a"
                android:textColor="#00FF41"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:enabled="false"
                android:alpha="0.45"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⏸  pause"
                    android:backgroundTint="#0a0f0a"
                    android:textColor="#00FF41"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:enabled="false"
                    android:alpha="0.45"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⏹  kill"
                    android:backgroundTint="#0a0f0a"
                    android:textColor="#FF3030"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:enabled="false"
                    android:alpha="0.45" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// share &gt; sharelink — bypass copy/paste"
            android:textSize="11sp"
            android:textColor="#1a8c1a"
            android:fontFamily="monospace"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#0d4a0d"
            android:fontFamily="monospace"
            android:layout_gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp" />

    </LinearLayout>
</ScrollView>
