<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:fillViewport="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShareLink"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#e94560"
            android:layout_gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi video tới màn hình lớn"
            android:textSize="13sp"
            android:textColor="#7a7a9a"
            android:layout_gravity="center"
            android:paddingBottom="28dp" />

        <!-- Card: Kết nối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÁY TÍNH"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#7a7a9a"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etIp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="192.168.1.x:8765"
                    android:textColorHint="#404060"
                    android:textColor="#ffffff"
                    android:inputType="text"
                    android:background="@drawable/input_bg"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:importantForAutofill="no"
                    android:autofillHints=""
                    android:privateImeOptions="nm" />

                <Button
                    android:id="@+id/btnScanQr"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="⬛"
                    android:backgroundTint="#16213e"
                    android:textColor="#e94560"
                    android:textSize="20sp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Kết nối"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#e94560"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- Status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="#F44336" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa kết nối"
                    android:textSize="12sp"
                    android:textColor="#a0a0b8"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: Video URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LINK VIDEO"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#7a7a9a"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dán link YouTube, TikTok, Facebook..."
                android:textColorHint="#404060"
                android:textColor="#ffffff"
                android:inputType="textUri"
                android:background="@drawable/input_bg"
                android:padding="12dp"
                android:textSize="13sp"
                android:minLines="2"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no"
                android:autofillHints=""
                android:privateImeOptions="nm" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="PHÁT TRÊN MÀN HÌNH LỚN"
                android:backgroundTint="#e94560"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Card: Điều khiển -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐIỀU KHIỂN"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="#7a7a9a"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⛶  Toàn màn hình"
                android:backgroundTint="#0f3460"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:enabled="false"
                android:alpha="0.45"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="⏸  Tạm dừng"
                    android:backgroundTint="#0f3460"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:enabled="false"
                    android:alpha="0.45"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="⏹  Đóng video"
                    android:backgroundTint="#5a1a1a"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:enabled="false"
                    android:alpha="0.45" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mẹo: Bấm chia sẻ trong Chrome, YouTube, TikTok rồi chọn ShareLink để gửi nhanh"
            android:textSize="11sp"
            android:textColor="#505070"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#505070"
            android:layout_gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

    </LinearLayout>
</ScrollView>
